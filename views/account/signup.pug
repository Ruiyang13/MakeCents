extends ../layout

block content
  .container.auth-wrap
    .auth-card
      .plane.stacked.faceted.ochre.p-4.p-md-5
        span.eyebrow= t('Start planning')
        h1.h2.mt-2.mb-4= t('Create your account')
        form(method='POST', action='/signup')
          input(type='hidden', name='_csrf', value=_csrf)
          .mb-3
            label.form-label(for='name')
              | #{ t('Name') }
              span.muted.fw-normal.ms-1= t('(optional)')
            input#name.form-control(type='text', name='name', maxlength='80', autocomplete='name')
          .mb-3
            label.form-label(for='email')= t('Email')
            input#email.form-control(type='email', name='email', autocomplete='email', required)
          .mb-3
            label.form-label(for='currency')= t('Currency')
            select#currency.form-select(name='currency', required)
              each c in currencies
                option(value=c.code, selected=c.code === 'GBP')= c.label
            .form-text= t('Amounts are recorded and shown in this currency. You can change it later in Account.')
          .mb-3
            label.form-label(for='password')= t('Password')
            input#password.form-control(type='password', name='password', minlength='8', maxlength='128', autocomplete='new-password', required)
            .form-text= t('At least 8 characters.')
          .mb-4
            label.form-label(for='confirmPassword')= t('Confirm password')
            input#confirmPassword.form-control(type='password', name='confirmPassword', minlength='8', maxlength='128', autocomplete='new-password', required)
          //- Plain-language notice: what goes to the AI provider, before any data exists
          .ai-notice.mb-4
            p.small.mb-2
              i.fas.fa-circle-info.me-2
              = t('MakeCents uses Claude, an AI model by Anthropic. To answer you, your messages, the transaction data the assistant looks up and any images you upload are sent to Anthropic for processing. Nothing is sent anywhere else, and images are not stored.')
            .form-check
              input#aiConsent.form-check-input(type='checkbox', name='aiConsent', value='yes', required)
              label.form-check-label.small(for='aiConsent')= t('I understand my data is processed by AI as described above.')
          button.btn.btn-danger.btn-lg.w-100(type='submit')= t('Create account')
        p.mt-4.mb-0.small.muted
          | #{ t('Already have an account?') }
          a.ms-1.fw-bold(href='/login')= t('Sign in')
