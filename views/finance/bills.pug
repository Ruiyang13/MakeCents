extends ../layout

block head
  link(rel='stylesheet', href='https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap')

block content
  - const short = (d) => new Date(d).toLocaleDateString(dateLocale, { day: 'numeric', month: 'short' });
  - const badge = { overlap: t('OVERLAP'), higher: t('PRICE RISE'), inactive: t('STOPPED?'), share: t('FIXED COSTS') };
  - const sevTag = { warning: t('WARNING'), saving: t('SAVE'), tip: t('TIP') };
  - const peakDay = days.reduce((a, d) => (d.total > a.total ? d : a), days[0]);
  - const upper = (s) => (lang === 'zh' ? s : s.toUpperCase());
  //- Insights tab follows the Lieflat Charts grammar in the Wire preset (grey ladder + one fluorescent-orange focal point).
  .container.pb-5.lieflat
    .lf-pagehead
      div
        h1= t('Insights')
      .lf-kpis
        div
          b.num= money(monthSpent)
          span= t('EVERYDAY · {month}', { month: upper(monthName) })
        div
          b.num= money(fixedPaid)
          span= t('FIXED PAID · {month}', { month: upper(monthName) })
        if bills.length
          div
            b.num= money(monthlyTotal)
            span= t('BILLS / MONTH')
          div
            b.num= money(soon)
            span= t('BILLS DUE IN 7 DAYS')

    //- Recommendations: deterministic signals from your own data, ranked (warnings, then biggest yearly saving)
    if recommendations.length
      .lf-card.lf-recs.mb-4
        h2= t("What I'd do next")
        ol.rec-items
          each r in recommendations
            li(class=`sev-${r.severity}`)
              .rec-main
                span.lf-tag(class=r.severity === 'warning' ? 'hero' : r.severity === 'tip' ? 'ghost' : '')= sevTag[r.severity]
                h3= r.title
                p.rec-evidence= r.evidence
                p.rec-action= r.action
                a.rec-ask(href=`/finance?q=${encodeURIComponent(r.ask)}`)
                  = t('Ask {app}: “{q}”', { app: appName, q: r.ask })
                  i.fas.fa-arrow-right.ms-2
              if r.savingLabel
                .rec-saving
                  b.num= r.savingLabel
                  span= t('/ YEAR')

    .lf-grid
      //- F2 · Hairline Line (basics-gallery.html · "Thirty days of sign-ups"), Wire colours
      .lf-card
        h2= monthSpent ? t('{amount} of everyday spending so far in {month}', { amount: money(monthSpent), month: monthName }) : t('No everyday spending yet in {month}', { month: monthName })
        .sub= t('orange = biggest day · fixed costs not included')
        svg#dayline(viewBox='0 0 400 320', preserveAspectRatio='xMidYMid meet', role='img', aria-label=t('Daily spending in {month}', { month: monthName }))

      //- F4 · Tick Donut, everyday spending by category this month
      .lf-card
        if everydayMix.length
          h2= t('{cat} is {pct}% of everyday spending', { cat: cat(everydayMix[0].name), pct: everydayMix[0].pct })
          .sub= t('one tick = 1%')
          svg#mixdonut(viewBox='0 0 400 320', preserveAspectRatio='xMidYMid meet', role='img', aria-label=t('Everyday spending by category this month'))
        else
          h2= t('No everyday spending yet this month')

      //- F4 · Tick Donut (basics-gallery.html · "Where the traffic comes from"), Wire CAT4
      .lf-card
        if composition.length
          h2= t('Of your fixed bills, {cat} takes {pct}%', { cat: cat(composition[0].name), pct: composition[0].pct })
          .sub= t('one tick = 1%')
          svg#billdonut(viewBox='0 0 400 320', preserveAspectRatio='xMidYMid meet', role='img', aria-label=t('Composition of monthly bills by category'))
        else
          h2= t('No recurring bills yet')

      each ins in insights
        .lf-card
          span.lf-badge= badge[ins.type]
          h2= ins.title
          .sub.mb-0= ins.text

      .lf-card.wide.lf-ask
        h2= t('Ask {app} about your spending', { app: appName })
        .chips.mt-2
          each q in askBills
            a.chip(href=`/finance?q=${encodeURIComponent(t(q))}`)= t(q)

  script#bills-data(type='application/json')!= JSON.stringify(chartData).replace(/</g, '\\u003c')

block scripts
  script(src=`/js/bills-charts.js?v=${v}`)
