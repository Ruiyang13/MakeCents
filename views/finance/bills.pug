extends ../layout

block head
  link(rel='stylesheet', href='https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap')

block content
  - const sevTag = { warning: t('WARNING'), saving: t('SAVE'), tip: t('TIP') };
  - const signed = (n) => (n > 0 ? '+' : '−') + money0(Math.abs(n));
  //- Insights, Copilot-style: one number, one pace chart, one ranked list, then what to do. Lieflat Wire colours.
  .container.pb-5.lieflat
    .lf-pagehead
      div
        h1= t('Insights')
        .lf-hero
          b.num= money0(monthSpent)
          span= t('spent in {month} so far', { month: monthName })
        if hasLast && paceChange
          p.lf-pace(class=paceChange > 0 ? 'up' : 'down')
            i.fas.me-2(class=paceChange > 0 ? 'fa-arrow-trend-up' : 'fa-arrow-trend-down')
            = paceChange > 0 ? t('{amount} more than this point in {month}', { amount: money0(paceChange), month: lastMonthName }) : t('{amount} less than this point in {month}', { amount: money0(-paceChange), month: lastMonthName })

    .lf-grid
      .lf-card
        h2= t('Spending pace')
        .lf-legend
          span.now= monthName
          if hasLast
            span.last= lastMonthName
        svg#pace(viewBox='0 0 400 250', preserveAspectRatio='xMidYMid meet', role='img', aria-label=t('Running total of everyday spending this month and last month'))

      .lf-card
        h2= t('Where it went')
        if categories.length
          svg#pie(viewBox='0 0 240 240', role='img', aria-label=t('Everyday spending by category this month'))
          ul.cat-rows
            each c, i in categories
              li(data-i=i, tabindex='0')
                span.cat-swatch
                span.cat-name= c.label
                span.cat-pct= `${c.pct}%`
                b.num= money0(c.spent)
                if c.change !== null
                  small.cat-change(class=c.change > 0 ? 'up' : 'down', title=t('vs the same point in {month}', { month: lastMonthName }))= c.change ? signed(c.change) : '='
        else
          p.text-muted.small= t('No everyday spending yet this month')
        if fixedMonthly
          p.cat-fixed= t('Plus {amount} a month in fixed bills, kept apart', { amount: money0(fixedMonthly) })

    if recommendations.length || alerts.length
      .lf-card.lf-recs.mt-4
        h2= t("What I'd do next")
        ol.rec-items
          each r in recommendations
            li(class=`sev-${r.severity}`)
              .rec-main
                span.lf-tag(class=r.severity === 'warning' ? 'hero' : r.severity === 'tip' ? 'ghost' : '')= sevTag[r.severity]
                h3= r.title
                p.rec-action
                  = r.action
                  a.rec-ask.ms-2(href=`/finance?q=${encodeURIComponent(r.ask)}`, title=r.ask, aria-label=t('Ask {app}: “{q}”', { app: appName, q: r.ask }))
                    i.fas.fa-arrow-right
              if r.savingLabel
                .rec-saving
                  b.num= r.savingLabel
                  span= t('/ YEAR')
          each a in alerts
            li
              .rec-main
                span.lf-tag.ghost= t('BILLS')
                h3= a.title
                p.rec-action= a.text

block scripts
  script#bills-data(type='application/json')!= JSON.stringify(chartData).replace(/</g, '\\u003c')
  script(src=`/js/bills-charts.js?v=${v}`)
