//- Piggy bank that fills with gold as a goal fills up.
//- pct 0–100 sets the fill height inside the body; level (0–4) changes the pig's look; uid keeps clip ids unique.
mixin piggy(pct, level, uid, label)
  - const top = 42, bottom = 148; // body spans y 42–148
  - const fillY = bottom - (Math.min(100, pct) / 100) * (bottom - top);
  - const coins = [[70, 140, 7], [98, 132, 6], [128, 142, 7], [152, 128, 6], [84, 118, 5], [118, 112, 6]];
  - const sparks = [[40, 38], [196, 46], [26, 128]];
  - const body = 'M36 95 C36 60 70 40 112 40 C150 40 178 60 180 92 C182 124 156 150 112 150 C66 150 36 130 36 95 Z';
  svg.piggy(viewBox='0 0 230 180', class=`lv-${level}`, role='img', aria-label=label)
    defs
      clipPath(id=`pig-clip-${uid}`)
        path(d=body)
    //- legs and ear behind the body
    rect.pig-part(x='62', y='132', width='18', height='30', rx='7')
    rect.pig-part(x='92', y='138', width='18', height='26', rx='7')
    rect.pig-part(x='124', y='138', width='18', height='26', rx='7')
    rect.pig-part(x='150', y='130', width='18', height='30', rx='7')
    path.pig-part(d='M132 50 L146 18 L162 54 Z')
    //- body
    path.pig-body(d=body)
    //- the savings: gold rising from the bottom, clipped to the body, with a moving wave on top
    g(clip-path=`url(#pig-clip-${uid})`)
      g.pig-fill(style=`--rise: ${bottom - fillY + 12}px`)
        if pct > 0
          path.pig-gold-wave(d=`M-40 ${fillY} q 15 -7 30 0 t 30 0 t 30 0 t 30 0 t 30 0 t 30 0 t 30 0 t 30 0 t 30 0 t 30 0 V 190 H -40 Z`)
          rect.pig-gold(x='0', y=fillY + 3, width='230', height=bottom - fillY + 10)
          //- a few coins inside the gold
          each c in coins
            if c[1] > fillY + 8
              circle.pig-coin(cx=c[0], cy=c[1], r=c[2])
    path.pig-outline(d=body)
    //- snout, nostrils, eye, coin slot, tail
    ellipse.pig-snout(cx='184', cy='96', rx='15', ry='19')
    ellipse.pig-nostril(cx='180', cy='90', rx='2.4', ry='4')
    ellipse.pig-nostril(cx='189', cy='101', rx='2.4', ry='4')
    if level >= 4
      path.pig-eye-happy(d='M142 76 q 6 -7 12 0')
    else
      circle.pig-eye(cx='148', cy='76', r='4.2')
    rect.pig-slot(x='92', y='44', width='34', height='6', rx='3')
    path.pig-tail(d='M38 90 c -14 -6 -20 8 -10 12 c 9 4 11 -10 1 -14')
    //- full: a coin on the slot and sparkles
    if level >= 4
      circle.pig-coin.top(cx='109', cy='32', r='10')
      each s in sparks
        path.pig-spark(
          d=`M${s[0]} ${s[1] - 8} L${s[0] + 2.5} ${s[1] - 2.5} L${s[0] + 8} ${s[1]} L${s[0] + 2.5} ${s[1] + 2.5} L${s[0]} ${s[1] + 8} L${s[0] - 2.5} ${s[1] + 2.5} L${s[0] - 8} ${s[1]} L${s[0] - 2.5} ${s[1] - 2.5} Z`
        )
