    "bootstrap": "^5.3.8",
    "compression": "^1.8.1",
    "connect-mongo": "^6.0.0",
    "dompurify": "^3.4.16",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
